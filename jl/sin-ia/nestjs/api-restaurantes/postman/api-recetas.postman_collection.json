{
  "info": {
    "name": "API Restaurantes y Recetas",
    "description": "Colección separada por acceso público y acceso protegido. Empieza por Publico/Auth para obtener authToken y luego usa Protegido para probar escritura y recursos autenticados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "restaurantId",
      "value": "1"
    },
    {
      "key": "recipeId",
      "value": "1"
    },
    {
      "key": "userImagePath",
      "value": "C:/ruta/a/tu/user-image.jpg"
    },
    {
      "key": "restaurantImagePath",
      "value": "C:/ruta/a/tu/restaurant-image.jpg"
    },
    {
      "key": "recipeImagePath",
      "value": "C:/ruta/a/tu/recipe-image.jpg"
    },
    {
      "key": "publicFileName",
      "value": "recipe-tostada-senior-cat.jpg"
    }
  ],
  "item": [
    {
      "name": "Publico",
      "description": "Endpoints que no requieren token.",
      "item": [
        {
          "name": "1. Auth",
          "description": "Registro y login. El login guarda authToken automáticamente.",
          "item": [
            {
              "name": "POST register",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"usuario-postman\",\n  \"password\": \"clave123\"\n}"
                },
                "description": "Crea un usuario nuevo.",
                "url": {
                  "raw": "{{baseUrl}}/auth/register",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "register"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "POST login Senior Cat",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "const json = pm.response.json();",
                      "if (json && json.access_token) {",
                      "  pm.collectionVariables.set('authToken', json.access_token);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Senior Cat\",\n  \"password\": \"seniorcat123\"\n}"
                },
                "description": "Login con el usuario seed.",
                "url": {
                  "raw": "{{baseUrl}}/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "login"
                  ]
                }
              },
              "response": []
            }
          ]
        },
        {
